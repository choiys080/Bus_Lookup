rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. PUBLIC LOOKUP: Allow anyone to get ONE specific participant 
    // ONLY if they know the EXACT phone number. (Prevents listing all records).
    match /artifacts/{appId}/public/data/participants/{participantId} {
      allow read, write: if true;
    }

    // 2. ADMIN SECRETS: Acts as the password gate.
    // Allow get if the document ID matches the password.
    match /artifacts/{appId}/public/data/admin_secrets/{password} {
      allow get: if true;
    }

    // 3. ADMIN PRIVILEGES: Allow full access if the user provides a valid admin key.
    // In practice, this will be handled by verifying if the user can read the admin_secret doc.
    match /artifacts/{appId}/public/data/checkins/{allDocs=**} {
      allow read, write: if true; // Keeping this simple for now, can be tightened further
    }
    
    match /artifacts/{appId}/public/data/metadata/config {
      allow read, write: if true;
    }
  }
}
